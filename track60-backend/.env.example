# ==========================================================
# VARIABLES DE ENTORNO - TRACK60 BACKEND (NO SUBIR SECRETOS)
# ==========================================================
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# MongoDB Atlas (reemplazar con tu URI real en Render o .env local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/track60?retryWrites=true&w=majority

# Seguridad JWT (mínimo 32 caracteres en producción)
JWT_SECRET=TRACK60_DEV_SECRET_KEY_CAMBIAR_EN_PRODUCCION_2026_DARNEL
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Orígenes CORS permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://track60-web.onrender.com

# Almacenamiento externo de fotografías (cloudinary | r2 | local_dev)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

